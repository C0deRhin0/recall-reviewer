# Local demo is explicit. It is rejected on Vercel, including previews.
APP_MODE=demo
APP_ORIGIN=http://127.0.0.1:3000
# Managed mode: APP_MODE=managed, then supply the following externally.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
OWNER_EMAILS=
# Required for public managed login/recovery; configure Auth CAPTCHA too.
TURNSTILE_SITE_KEY=
# Set the Turnstile SECRET in Supabase Auth CAPTCHA settings, not here.


